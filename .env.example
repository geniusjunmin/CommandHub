# Copy to .env and replace every required value before starting.
POSTGRES_PASSWORD=
COMMANDHUB_ADMIN_EMAIL=admin@example.com
COMMANDHUB_ADMIN_PASSWORD=
COMMANDHUB_HOST=localhost
ALLOW_CRITICAL_COMMANDS=false

EXECUTION_GLOBAL_CONCURRENCY=10
EXECUTION_PER_SERVER_CONCURRENCY=3
EXECUTION_PER_USER_CONCURRENCY=3
EXECUTION_QUEUE_CAPACITY=100
EXECUTION_DEFAULT_TIMEOUT_SECONDS=300
EXECUTION_MAXIMUM_TIMEOUT_SECONDS=3600
EXECUTION_MAXIMUM_OUTPUT_BYTES=10485760

# Development-only docker compose --profile test fixture.
SSH_FIXTURE_PASSWORD=
