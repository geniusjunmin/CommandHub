<div class="nav-item px-3"><NavLink class="nav-link" href="@Url" Match="@Match"><span class="bi @Icon" aria-hidden="true"></span> @Text</NavLink></div>
@code {
    [Parameter, EditorRequired] public string Url { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "bi-circle";
    [Parameter] public NavLinkMatch Match { get; set; }
}
